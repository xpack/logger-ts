{
  "name": "@xpack/logger",
  "version": "7.0.0-pre",
  "description": "A Node.js ES6 module with a generic console logger class",
  "type": "module",
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "src/",
    "!src/README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xpack/logger-ts.git"
  },
  "keywords": [
    "cli",
    "logger",
    "log",
    "console",
    "level",
    "silent",
    "error",
    "warn",
    "info",
    "verbose",
    "debug",
    "trace"
  ],
  "author": {
    "name": "Liviu Ionescu",
    "email": "ilg@livius.net",
    "url": "https://github.com/ilg-ul"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/xpack/logger-ts/issues"
  },
  "homepage": "https://xpack.github.io/logger-ts/",
  "$dependenciesUrls": {
    "del-cli": "https://www.npmjs.com/package/del-cli",
    "glob": "https://www.npmjs.com/package/glob",
    "json": "https://www.npmjs.com/package/json",
    "liquidjs": "https://www.npmjs.com/package/liquidjs",
    "@tsconfig/node22": "https://www.npmjs.com/package/@tsconfig/node22",
    "@types/node": "https://www.npmjs.com/package/@types/node",
    "tap": "https://www.npmjs.com/package/tap",
    "ts-node": "https://www.npmjs.com/package/ts-node",
    "eslint": "https://www.npmjs.com/package/eslint",
    "@eslint/js": "https://www.npmjs.com/package/@eslint/js",
    "eslint-config-prettier": "https://www.npmjs.com/package/eslint-config-prettier",
    "typescript-eslint": "https://www.npmjs.com/package/typescript-eslint",
    "prettier": "https://www.npmjs.com/package/prettier",
    "typescript": "https://www.npmjs.com/package/typescript"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/tap": "^15.0.12",
    "@xpack/mock-console": "^1.0.0",
    "del-cli": "^8.0.1",
    "json": "^11.0.0",
    "liquidjs": "^10.30.1",
    "standard": "^17.1.2",
    "tap": "^21.8.1",
    "ts-node": "^10.9.2",
    "ts-standard": "^12.0.2",
    "typescript": "^6.0.3",
    "glob": "^14.0.4",
    "@tsconfig/node22": "^22.0.6",
    "eslint": "^10.14.0",
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "typescript-eslint": "^8.72.2",
    "prettier": "^3.9.10"
  },
  "bundleDependencies": [],
  "scripts": {
    "generate-top-commons": "node node_modules/@xpack/npm-packages-helper/maintenance/scripts/generate-top-commons.mjs --xpack",
    "compile-watch": "tsc --project tsconfig.json --watch",
    "prettier": "prettier src tests --write --config maintenance/config/.prettierrc.json --ignore-path maintenance/config/.prettierignore",
    "fix": "eslint --config maintenance/config/eslint.config.js --fix src",
    "compile": "tsc --project tsconfig.json && tsc --project tsconfig-declarations.json",
    "compile-tests": "tsc --project maintenance/config/tsconfig-tests.json",
    "fix-compile": "npm run prettier && npm run fix && npm run compile",
    "lint": "eslint --config maintenance/config/eslint.config.js src",
    "npm-install": "npm install",
    "npm-link": "npm link",
    "npm-link-helpers": "npm link @xpack/npm-packages-helper",
    "npm-link-deps": "npm link @xpack/logger",
    "npm-outdated": "npm outdated",
    "npm-update": "npm update",
    "postversion": "git push origin --all && git push origin --tags",
    "npm-pack": "npm pack",
    "git-log": "git log --pretty='%cd * %h %s' --date=short",
    "prepare": "del-cli dist && npm run prettier && npm run lint && npm run compile",
    "pretest": "npm run compile && npm run compile-tests",
    "test-ci": "tap run --reporter=terse",
    "test": "npm run test-coverage",
    "test-coverage": "tap --show-full-coverage",
    "test-no-coverage": "tap --disable-coverage",
    "test-all": "tap run --reporter=tap --disable-coverage",
    "test-one": "tap run --reporter=tap --coverage-map=tests/coverage-map.js tests/tap/*/object-substitution.ts",
    "test-tap-config-list": "tap config list",
    "tap": "tap --reporter=tap",
    "dev-cycle": "npm run fix && npm run compile && npm run test",
    "clean": "del-cli --force dist build .tap",
    "deep-clean": "npm run clean && del-cli --force node_modules package-lock.json",
    "update-changelog": "node maintenance/scripts/update-changelog.mjs CHANGELOG.md",
    "npm-audit": "npm audit fix --force",
    "dumpconf": "env | sort | uniq",
    "show-versions": "echo $(which node) $(node --version) && echo $(which npm) $(npm --version)",
    "pretest-coverage": "npm run lint",
    "pretest-no-coverage": "npm run lint",
    "prepublishOnly": "npm run test",
    "postpublish": "git push origin --follow-tags"
  },
  "engines": {
    "node": ">=22.12"
  }
}
