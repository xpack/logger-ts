{
  // Use IntelliSense to learn about possible Node.js debug attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  //
  // The tests run under tap, which starts each test file in a child
  // process; the integrated terminal of the debugger attaches to it.
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "tap: current file",
      "command": "npm run test-one -- ${relativeFile}",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "tap 020-logger-single.ts",
      "command": "npm run test-one -- tests/tap/020-logger-single.ts",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "tap 030-logger-multi.ts",
      "command": "npm run test-one -- tests/tap/030-logger-multi.ts",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "tap 040-is-level.ts",
      "command": "npm run test-one -- tests/tap/040-is-level.ts",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "tap 050-buffer.ts",
      "command": "npm run test-one -- tests/tap/050-buffer.ts",
      "cwd": "${workspaceFolder}"
    }
  ]
}
